{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chogpit-game",
  "main": "./worker.mjs",
  "workers_dev": true,
  "routes": [{ "pattern": "chogpit.tech", "custom_domain": true }],
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz", "/ws"]
  },
  "alias": { "ws": "./ws-shim.mjs" },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "ChogpitGame" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChogpitGame"] }]
}
